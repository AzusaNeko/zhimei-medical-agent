# ════════════════════════════════════════════════════════════════
#  智美医美顾问 MVP · 环境变量样例
#  用法：copy .env.example .env  然后按需填写
#  —— 不要提交真实密钥（.env 已在 .gitignore 里）——
# ════════════════════════════════════════════════════════════════
#
#  ⚠️ 端口/凭据：本机已有一套现成的 Postgres + Milvus 在跑
#  （容器名 bid_agent_postgres / bid_agent_milvus，属于另一个项目）。
#  **优先复用它**，不要再起一套 —— 下面「情形 A」就是复用配置。
#  如果你希望完全独立，用「情形 B」起 docker-compose.yml 里那套。

# ── 运行档位 ──
# real : 连真实 Postgres / Milvus / DeepSeek / BGE（默认）
# fake : 全部走内存与脚本化假实现，用于「还没配 key 时自检图接线」
APP_PROFILE=real

# ── 大模型（DeepSeek，OpenAI 兼容接口）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 二次复核用的模型。留空 = 同族复核（MVP 默认），审计会记 escalation_independent=false
# 想让复核真正独立，填另一家模型（例如另一个供应商的 endpoint + model）
ESCALATION_BASE_URL=
ESCALATION_API_KEY=
ESCALATION_MODEL=

# ════════════════════════════════════════════════════════════════
#  情形 A（推荐）：复用本机现成实例
#    Postgres → localhost:5434（容器 bid_agent_postgres）
#    Milvus   → localhost:19532（容器 bid_agent_milvus, v2.4.0）
#
#  ⚠️ 需要先在这台 Postgres 里建一个本项目专用的库（不要用别人的库）：
#     docker exec bid_agent_postgres psql -U bidagent \
#       -c "CREATE DATABASE zhimei OWNER bidagent;"
# ════════════════════════════════════════════════════════════════
PG_DSN=postgresql://bidagent:bidagent123@localhost:5434/zhimei
MILVUS_URI=http://localhost:19532

# ════════════════════════════════════════════════════════════════
#  情形 B：用仓库里的 docker-compose.yml 起独立一套（端口已错开）
#    docker compose up -d
#        Postgres → localhost:55432    Milvus → localhost:19530
# ════════════════════════════════════════════════════════════════
# PG_DSN=postgresql://zhimei:zhimei@localhost:55432/zhimei
# MILVUS_URI=http://localhost:19530

# ── Milvus 集合名 ──
# ⚠️ 复用共享 Milvus 实例时**必须带项目前缀**，否则可能和别的项目的集合撞名
MILVUS_COLLECTION=zhimei_kb_chunks
MILVUS_TOKEN=

# ── 进程内模型（BGE）──
BGE_M3_PATH=BAAI/bge-m3
BGE_RERANKER_PATH=BAAI/bge-reranker-v2-m3
EMBED_DEVICE=cpu
RERANK_DEVICE=cpu
# 并发与线程：torch 每个任务只用 1 线程，靠线程池并发（避免抢核导致延迟抖动）
EMBED_CONCURRENCY=4
RERANK_CONCURRENCY=4
# 国内网络建议开镜像（BGE-M3 约 2.2GB）
# HF_ENDPOINT=https://hf-mirror.com

# ── 放行凭据签名密钥（生产必须换成随机长串并妥善保管）──
RELEASE_SECRET=dev-only-change-me

# ── 预算与时效 ──
MAX_REVISION=2
MAX_CLARIFY=2
KB_MAX_VERIFY_LOOP=3
RECURSION_LIMIT=40
TOKEN_TTL_SECONDS=1800
PLAN_EXPIRE_SECONDS=1800

# ── 模型超时（秒）──
T_UNDERSTAND=8
T_GENERATE=30
T_REVIEW=20

# ── 检索 ──
RECALL_K=40
RERANK_TOP_K=8
MAX_EVIDENCE=6
MIN_RERANK=0.30

# ── 规则文件 ──
RULES_PATH=app/config/rules.yaml
